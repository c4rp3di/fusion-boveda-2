<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sin INTERNET a propósito: La Bóveda no puede enviar nada fuera del teléfono. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        Puente con el Teclado Soberano (botón 🔑). Permiso de firma: solo apps firmadas con la misma llave
        que La Bóveda pueden abrir PuenteTecladoActivity. Se declara también en el teclado (misma firma).
    -->
    <permission
        android:name="com.vigia.boveda.permission.PUENTE_TECLADO"
        android:protectionLevel="signature" />

    <!-- Para elegir la app vinculada a una contraseña sin pedir QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VigiaCore">

        <activity
            android:name=".DesbloqueoActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PrincipalActivity"
            android:exported="false" />

        <!--
            Exportada (la lanza el teclado, otra app) pero protegida por permiso de firma: el sistema rechaza
            a cualquier llamante que no lo tenga. Tarea propia (taskAffinity) para que, al terminar, el usuario
            vuelva a la app donde escribía y no a la pantalla principal de La Bóveda.
        -->
        <activity
            android:name=".PuenteTecladoActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="com.vigia.boveda.permission.PUENTE_TECLADO"
            android:taskAffinity="com.vigia.boveda.puente"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".EditarCredencialActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".BovedaAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

    </application>

</manifest>
